# Copy this file to .env and paste your real keys. Never commit .env.
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Cloudflare Turnstile (human check on the public demo). Leave both empty to switch it off locally.
RS_TURNSTILE_SITE_KEY=
RS_TURNSTILE_SECRET=
